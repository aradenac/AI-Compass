# Copy using: python3 scripts/init-env.py
# NEVER commit the generated .env
DB_NAME=ai_compass
DB_USER=ai_compass
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
AI_COMPASS_HTTP_PORT=8080

# FUT-02: defaults to localhost-only HTTP. Never treat this as LAN configuration.
AI_COMPASS_PROFILE=development
# For LAN, use compose.lan.yaml, a trusted HTTPS certificate and preflight:
# AI_COMPASS_LAN_BIND=192.168.1.20
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,192.168.1.20
# DJANGO_CSRF_TRUSTED_ORIGINS=https://192.168.1.20
# AI_COMPASS_TLS_PROXY=1
# AI_COMPASS_LAN_CERT=./secrets/lan.crt
# AI_COMPASS_LAN_KEY=./secrets/lan.key
# FUT-20 Internet/inter-BU profile (fails closed; see docs/capacity-and-internet-profile.md).
# Never inherit loopback defaults for public ingress; preflight before starting:
# AI_COMPASS_PROFILE=internet
# AI_COMPASS_TLS_PROXY=1
# DJANGO_ALLOWED_HOSTS=compass.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://compass.example.com
# AI_COMPASS_LAN_CERT=./secrets/internet.crt
# AI_COMPASS_LAN_KEY=./secrets/internet.key
