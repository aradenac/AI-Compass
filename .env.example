# Copy using: python3 scripts/init-env.py
# NEVER commit the generated .env
DB_NAME=ai_compass
DB_USER=ai_compass
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
AI_COMPASS_HTTP_PORT=8080
# PostgreSQL logical snapshot destination. The default is a same-host directory
# under the repository: it is NOT disaster-recovery protection. For real
# protection, point this at a different physical disk or an off-host mount and
# set AI_COMPASS_BACKUP_REQUIRE_MOUNT=1 so backups fail loudly if that
# destination is not actually mounted. Coordinated off-host automation is #29.
AI_COMPASS_BACKUP_DIR=.local/backups
AI_COMPASS_BACKUP_RETENTION=14
AI_COMPASS_BACKUP_REQUIRE_MOUNT=0
